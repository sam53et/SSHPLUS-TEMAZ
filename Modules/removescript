#!/bin/bash
# removescript – SSH Plus Manager kurulumunu TAM olarak kaldırır (menü [19] REMOVE SCRIPT).
# install.sh + Install/list dosyalarına göre kurulan HER dosya/dizin/crontab satırı buradan silinir.

# Renk yardımcılarını yükle (kurulu yol / bin yolu / script yanı)
if [[ -f /etc/SSHPlus/colors ]]; then
	source /etc/SSHPlus/colors
elif [[ -f /bin/colors ]]; then
	source /bin/colors
elif [[ -f "$(dirname "$0")/colors" ]]; then
	source "$(dirname "$0")/colors"
fi

banner_info "          REMOVE SCRIPT                 "
echo ""
msg_err "This will remove the SSH Plus Manager installation!"
color_echo_n "Are you absolutely sure? [y/N]: " "red"
read -r confirm
if [[ "$confirm" =~ ^[Yy]$ ]]; then
	color_echo_n "Type 'DELETE' to confirm: " "red"
	read -r confirm2
	if [[ "$confirm2" == "DELETE" ]]; then
		color_echo "Removing installation..." "yellow"

		# 1) /bin altına Install/list tarafından indirilen TÜM modüller (_mdls dizisiyle birebir)
		rm -f /bin/changepassword /bin/createuser /bin/expiredusers /bin/changeexpiration 2>/dev/null
		rm -f /bin/expirationmanager /bin/removeuser /bin/verifbot /bin/droplimiter 2>/dev/null
		rm -f /bin/changelimit /bin/ajuda /bin/sshmonitor /bin/userbackup /bin/instsqd 2>/dev/null
		rm -f /bin/menu /bin/speedtest /bin/bannersetup /bin/serversettings 2>/dev/null
		rm -f /bin/restartservices /bin/rebootsystem /bin/updatescript /bin/connections 2>/dev/null
		rm -f /bin/vpsinfo /bin/userinfo /bin/verifatt /bin/uexpired 2>/dev/null
		rm -f /bin/multiport /bin/vpstraffic /bin/autorun 2>/dev/null
		# [YENİ] Ookla Speedtest CLI kaldırma sırasında temizleniyor
		rm -f /usr/local/bin/ookla-speedtest 2>/dev/null
		# removescript kendi kendini en son siler (çalışırken silinmesi Linux'ta sorunsuzdur)
		rm -f /bin/removescript 2>/dev/null

		# 2) install.sh'nin ayrıca /bin altına yazdığı ekstra dosyalar
		rm -f /bin/h /bin/version 2>/dev/null

		# 3) Install/list tarafından indirilip /etc/SSHPlus'a taşınan yardımcı dosyalar
		#    (dizinin tamamını sildiğimiz için tek tek silmeye gerek yok ama emin olmak için:)
		rm -f /etc/SSHPlus/cabecalho /etc/SSHPlus/bot /etc/SSHPlus/open.py 2>/dev/null
		rm -f /etc/SSHPlus/proxy.py /etc/SSHPlus/colors /etc/SSHPlus/db 2>/dev/null

		# 4) /etc/SSHPlus tüm yapılandırma dizini (userteste, .tmp, version dahil)
		rm -rf /etc/SSHPlus 2>/dev/null

		# 5) /etc/bot bot verileri dizini (info-users, arquivos, revenda, suspensos, lista_*)
		rm -rf /etc/bot 2>/dev/null

		# 6) Diğer kök seviyesi dosyalar (Install/list ve install.sh tarafından oluşturulan)
		rm -f /etc/autostart /etc/IP /usr/lib/sshplus /usr/lib/licence 2>/dev/null
		# install.sh'nin geçici indirme dizini (normalde Install/list kendini siler, garanti olsun diye)
		rm -f /usr/local/lib/list 2>/dev/null

		# 7) Kullanıcı veritabanı, oturum kayıtları ve yedekleri (HOME dizininde, genelde /root)
		rm -f "${HOME:-/root}/users.db" "${HOME:-/root}/sessions.log" 2>/dev/null
		rm -f "${HOME:-/root}/users.db.lock" 2>/dev/null
		rm -rf "${HOME:-/root}/users.db.lock.d" 2>/dev/null
		rm -f "${HOME:-/root}"/users.db.bak.* 2>/dev/null
		rm -f /home/sshplus 2>/dev/null

		# 8) Kurulum/uygulama log dizini
		rm -rf /var/log/sshplus /tmp/sshplus-install.log 2>/dev/null

		# 9) install.sh/Install/list tarafından eklenen crontab satırlarını temizle
		#    (diğer kullanıcı crontab satırlarına dokunulmaz, sadece bu 4 satır kaldırılır)
		crontab -l 2>/dev/null | grep -v -F \
			-e '/bin/verifatt' \
			-e '@reboot /etc/autostart' \
			-e '* * * * * /etc/autostart' \
			-e '/bin/uexpired' \
			| crontab - 2>/dev/null

		# 10) install.sh tarafından açılan UFW portlarını kapat (varsa)
		if [[ -x /usr/sbin/ufw ]]; then
			/usr/sbin/ufw delete allow 3128/tcp >/dev/null 2>&1
			/usr/sbin/ufw delete allow 8799/tcp >/dev/null 2>&1
		fi

		msg_ok "Script and all installed files fully removed."
		sleep 3
		exit 0
	fi
fi
color_echo "Removal cancelled." "green"
sleep 2
